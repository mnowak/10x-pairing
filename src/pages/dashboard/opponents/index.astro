---
import Layout from "@/layouts/Layout.astro";
import OpponentsList from "@/components/opponent/OpponentsList";
import { createClient } from "@/lib/supabase";
import { getOpponentsWithArmies } from "@/lib/opponents";

let error = Astro.url.searchParams.get("error");
const { user } = Astro.locals;

const supabase = createClient(Astro.request.headers, Astro.cookies);
let opponents: Awaited<ReturnType<typeof getOpponentsWithArmies>> = [];
if (supabase && user) {
  try {
    opponents = await getOpponentsWithArmies(supabase, user.id);
  } catch {
    error ??= "Something went wrong loading your opponents";
  }
}
---

<Layout title="Opponents">
  <div class="bg-cosmic flex min-h-screen items-center justify-center p-4">
    <div class="w-full max-w-md rounded-2xl border border-white/10 bg-white/10 p-8 text-white backdrop-blur-xl">
      <h1
        class="mb-6 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-center text-2xl font-bold text-transparent"
      >
        Opponents
      </h1>
      <OpponentsList opponents={opponents} serverError={error} client:load />
      <p class="mt-4 text-center text-sm text-blue-100/60">
        <a href="/dashboard" class="text-purple-300 hover:underline">← Back to dashboard</a>
      </p>
    </div>
  </div>
</Layout>
