---
import Layout from "@/layouts/Layout.astro";
import MatchSession from "@/components/match/MatchSession";
import { createClient } from "@/lib/supabase";
import { getTeamWithArmies } from "@/lib/teams";
import { getOpponentWithArmies } from "@/lib/opponents";
import { getMatrixGrid } from "@/lib/matrix";
import { MAX_ROSTER_SIZE } from "@/lib/rosterLimits";
import { logError } from "@/lib/logError";

const { id } = Astro.params;
const { user } = Astro.locals;

const supabase = createClient(Astro.request.headers, Astro.cookies);
if (!supabase || !user || !id) {
  return Astro.redirect("/dashboard/opponents");
}

let opponent;
try {
  opponent = await getOpponentWithArmies(supabase, user.id, id);
} catch (err) {
  logError("match.astro: getOpponentWithArmies", err);
  return Astro.redirect(
    `/dashboard/opponents?error=${encodeURIComponent("Something went wrong loading that opponent")}`,
  );
}
if (!opponent) {
  return Astro.redirect("/dashboard/opponents");
}

let team;
try {
  team = await getTeamWithArmies(supabase, user.id);
} catch (err) {
  logError("match.astro: getTeamWithArmies", err);
  return Astro.redirect(
    `/dashboard/opponents/${id}?error=${encodeURIComponent("Something went wrong loading your team")}`,
  );
}
if (!team) {
  return Astro.redirect(`/dashboard/team?error=${encodeURIComponent("Create your team before starting match mode")}`);
}

let matrixGrid;
try {
  matrixGrid = await getMatrixGrid(supabase, user.id, opponent);
} catch (err) {
  logError("match.astro: getMatrixGrid", err);
  return Astro.redirect(
    `/dashboard/opponents/${id}?error=${encodeURIComponent("Something went wrong loading the matrix")}`,
  );
}
if (!matrixGrid) {
  return Astro.redirect(`/dashboard/opponents/${id}`);
}

const ourCount = team.armies.length;
const theirCount = opponent.armies.length;
const rosterReady = ourCount === MAX_ROSTER_SIZE && theirCount === MAX_ROSTER_SIZE;
---

<Layout title={`Match mode — ${opponent.name}`}>
  <div class="bg-cosmic flex min-h-screen items-center justify-center p-4">
    <div class="w-full max-w-4xl rounded-2xl border border-white/10 bg-white/10 p-8 text-white backdrop-blur-xl">
      <h1
        class="mb-6 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-center text-2xl font-bold text-transparent"
      >
        Match mode — {opponent.name}
      </h1>
      {
        rosterReady ? (
          <MatchSession
            opponentId={opponent.id}
            ourArmies={team.armies}
            theirArmies={opponent.armies}
            matrixGrid={matrixGrid}
            mode="live"
            client:only="react"
          />
        ) : (
          <div class="space-y-2 rounded-lg border border-amber-400/30 bg-amber-400/10 p-4 text-sm text-amber-100">
            <p class="font-semibold">Both rosters need exactly {MAX_ROSTER_SIZE} armies before match mode can start.</p>
            <p>
              Your team: {ourCount}/{MAX_ROSTER_SIZE} armies. {opponent.name}: {theirCount}/{MAX_ROSTER_SIZE} armies.
            </p>
          </div>
        )
      }
      <p class="mt-4 text-center text-sm text-blue-100/60">
        <a href={`/dashboard/opponents/${id}`} class="text-purple-300 hover:underline">
          ← Back to {opponent.name}
        </a>
      </p>
    </div>
  </div>
</Layout>
